# Copy to .env (python manage.py loads it) or set these in the environment. Demo values.

# --- required in production ---
SECRET_KEY=replace-with-a-long-random-string-of-50-or-more-characters
ALLOWED_HOSTS=example.com,www.example.com
# Needed behind a proxy or on another origin, e.g. https://example.com
CSRF_TRUSTED_ORIGINS=

# --- local development ---
DEBUG=false                 # true only on your own machine (shows error pages, no HTTPS redirect)

# --- production hardening (defaults suit a site behind a TLS-terminating proxy) ---
HTTPS_ONLY=true             # false for a plain-HTTP deployment
HSTS_SECONDS=3600

# --- data ---
DATABASE_PATH=              # SQLite file; default ./db.sqlite3
STATIC_ROOT=                # default ./staticfiles
MEDIA_ROOT=                 # default ./media
LOG_LEVEL=INFO

# --- the live inventory list (a Google Sheet exported as a PDF) ---
GOOGLE_APPLICATION_CREDENTIALS=/path/outside/the/repository/service-account.json
INVENTORY_SHEET_ID=replace-with-the-id-from-the-sheet-url
INVENTORY_CACHE_SECONDS=300
